# SPDX-License-Identifier: MIT
if ESP_BOARD_ESP32_8048S050 && IDF_TARGET_ESP32S3

config GUITION_ESP32_8048S050_TOUCH_PROFILE
    bool
    default y
    select GUITION_BOARD_TOUCH_SELECT
    select GUITION_HAS_CAP_TOUCH

config GUITION_BOARD_TOUCH_SELECT
    bool
    help
        The selected board provides selectable touch devices.

config GUITION_BOARD_NO_PSRAM
    bool
    default y if GUITION_BOARD_TOUCH_SELECT && (IDF_TARGET_ESP32 || IDF_TARGET_ESP32C3)
    help
        Guition ESP32 and ESP32-C3 boards have no PSRAM. Use internal RAM
        task stacks and partial display buffers; CONFIG_SPIRAM is rejected.

menu "Guition touch"
    depends on GUITION_BOARD_TOUCH_SELECT

config GUITION_HAS_CAP_TOUCH
    bool

config GUITION_HAS_RES_TOUCH
    bool

config GUITION_DEFAULT_RES_TOUCH
    bool

config GUITION_DEFAULT_NO_TOUCH
    bool

choice GUITION_TOUCH_TYPE
    prompt "Touch variant"
    default GUITION_TOUCH_NONE if GUITION_DEFAULT_NO_TOUCH
    default GUITION_TOUCH_RESISTIVE if GUITION_DEFAULT_RES_TOUCH && GUITION_HAS_RES_TOUCH
    default GUITION_TOUCH_CAPACITIVE if GUITION_HAS_CAP_TOUCH
    default GUITION_TOUCH_NONE

config GUITION_TOUCH_NONE
    bool "No touch"
    help
        Keep LCD support; do not acquire a touch bus or create touch IO/driver.

config GUITION_TOUCH_CAPACITIVE
    bool "Capacitive touch"
    depends on GUITION_HAS_CAP_TOUCH
    select ESP_BOARD_PERIPH_I2C_SUPPORT

config GUITION_TOUCH_RESISTIVE
    bool "Resistive touch (XPT2046)"
    depends on GUITION_HAS_RES_TOUCH
    select ESP_BOARD_PERIPH_SPI_SUPPORT

endchoice

endmenu

config GUITION_BOARD_HAS_SD
    bool
    default y

config GUITION_SD_ENABLED
    bool "Enable Guition SD card support"
    depends on GUITION_BOARD_HAS_SD
    default n
    select ESP_BOARD_DEV_FS_FAT_SUPPORT
    select ESP_BOARD_PERIPH_SPI_SUPPORT

endif
