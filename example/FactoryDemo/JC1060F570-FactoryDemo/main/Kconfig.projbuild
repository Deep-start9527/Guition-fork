menu "FactoryDemo Configuration"

    choice FACTORY_DESKTOP_ICON_SOURCE
        prompt "Desktop icon source"
        default FACTORY_DESKTOP_ICONS_SPIFFS
        help
            Select PNG files in the assets SPIFFS partition or LVGL image
            descriptors compiled into the application for the selected panel.

        config FACTORY_DESKTOP_ICONS_SPIFFS
            bool "PNG files from SPIFFS"

        config FACTORY_DESKTOP_ICONS_EMBEDDED
            bool "Predecoded C images"
    endchoice

    config FACTORY_SNTP_SERVER
        string "SNTP server"
        default "pool.ntp.org"
        help
            Hostname used by the FactoryDemo time service after station IPv4 acquisition.

    config FACTORY_UART_ENABLE
        bool "Enable UART terminal"
        default y
        help
            Enable the UART terminal application and its background RX task.

    if FACTORY_UART_ENABLE

    config FACTORY_UART_PORT
        int "UART port number"
        range 0 4
        default 1
        help
            UART controller used by the terminal. Select a port that is not
            reserved by the console or another peripheral.

    config FACTORY_UART_TX_GPIO
        int "UART TX GPIO"
        range -1 61
        default 53 if ESP_BOARD_JC8048F550 || ESP_BOARD_JC8048F543
        default 14 if ESP_BOARD_JC1060F570C
        default 18
        help
            GPIO used for UART TX. Set to -1 to leave the TX signal unused.
            JC8048F550 / JC8048F543 use fixed UART1 TX GPIO53.

    config FACTORY_UART_RX_GPIO
        int "UART RX GPIO"
        range -1 61
        default 52 if ESP_BOARD_JC8048F550 || ESP_BOARD_JC8048F543
        default 11 if ESP_BOARD_JC1060F570C
        default 19
        help
            GPIO used for UART RX. Set to -1 to leave the RX signal unused.
            JC8048F550 / JC8048F543 use fixed UART1 RX GPIO52.

    config FACTORY_UART_BAUD_RATE
        int "UART baud rate"
        range 300 5000000
        default 115200
        help
            UART baud rate.

    config FACTORY_UART_RX_BUFFER_SIZE
        int "UART RX buffer size"
        range 256 16384
        default 2048
        help
            Driver RX buffer size in bytes.

    config FACTORY_UART_MESSAGE_MAX_LENGTH
        int "Maximum message length"
        range 32 512
        default 128
        help
            Maximum text bytes stored for one received or transmitted message.
            The terminal keeps at most 100 messages and evicts the oldest one.

    endif

endmenu

# Application defaults follow the selected board's Ethernet hardware.
config ETHERNET_INIT_DEFAULT_ETH_DISABLED
    default y if !ESP_BOARD_JC1060F570C

config ETHERNET_INIT_OVERRIDE_DISABLE
    default y if ESP_BOARD_JC8048F550 || ESP_BOARD_JC8048F543

config ETHERNET_INTERNAL_SUPPORT
    default y if ESP_BOARD_JC1060F570C

if ESP_BOARD_JC1060F570C && ETHERNET_INTERNAL_SUPPORT

choice ETHERNET_PHY_INTERFACE
    default ETHERNET_PHY_INTERFACE_RMII
endchoice

choice ETHERNET_PHY_MODEL
    default ETHERNET_PHY_IP101
endchoice

if ETHERNET_PHY_INTERFACE_RMII

choice ETHERNET_RMII_CLK_MODE
    default ETHERNET_RMII_CLK_INPUT
endchoice

config ETHERNET_RMII_CLK_GPIO
    default 13

config ETHERNET_RMII_TX_EN_GPIO
    default 12

config ETHERNET_RMII_TXD0_GPIO
    default 8

config ETHERNET_RMII_TXD1_GPIO
    default 9

config ETHERNET_RMII_CRS_DV_GPIO
    default 15

config ETHERNET_RMII_RXD0_GPIO
    default 19

config ETHERNET_RMII_RXD1_GPIO
    default 18

endif

config ETHERNET_MDC_GPIO
    default 53

config ETHERNET_MDIO_GPIO
    default 10

config ETHERNET_PHY_RST_GPIO
    default 17

endif
