# Common display demo defaults for isolated ESP-IDF v6.1 builds.
# Combine with the selected board's sdkconfig.defaults.board (BMGR does this).
CONFIG_PARTITION_TABLE_SINGLE_APP_LARGE=y
CONFIG_LV_COLOR_DEPTH_16=y
CONFIG_LV_MEM_SIZE=65536
CONFIG_LV_USE_DEMO_WIDGETS=y
CONFIG_LV_USE_DEMO_WIDGETS_SLIDESHOW=y
# CONFIG_LV_USE_FREETYPE is not set
# CONFIG_ESP_LVGL_ADAPTER_ENABLE_FREETYPE is not set
# CONFIG_ESP_LVGL_ADAPTER_ENABLE_FS is not set
# CONFIG_ESP_LVGL_ADAPTER_ENABLE_DECODER is not set
# CONFIG_ESP_LVGL_ADAPTER_ENABLE_BUTTON is not set
# CONFIG_ESP_LVGL_ADAPTER_ENABLE_KNOB is not set
